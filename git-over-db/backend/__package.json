{
  "name": "@nu-art/git-over-db-backend",
  "version": "$THUNDERSTORM_VERSION",
  "description": "Git-over-DB backend capability",
  "keywords": [
    "TacB0sS",
    "infra",
    "nu-art",
    "thunderstorm",
    "typescript",
    "git-over-db"
  ],
  "homepage": "https://github.com/quai-md/thunderstorm",
  "license": "Apache-2.0",
  "author": "TacB0sS",
  "scripts": {
    "build": "tsc"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": true
  },
  "dependencies": {
    "@nu-art/git-over-db-shared": "?",
    "@nu-art/firebase-backend": "?",
    "@nu-art/thunderstorm-backend": "?",
    "@nu-art/thunderstorm-shared": "?",
    "@nu-art/ts-common": "?",
    "firebase-admin": "?"
  },
  "unitConfig": {
    "type": "typescript-lib"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "import": "./*.js"
    }
  }
}
